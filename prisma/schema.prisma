// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  playitSecret String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Server {
  id                 String   @id @default(cuid())
  name               String
  ownerId            String   @default("guest")
  ownerName          String   @default("Guest")
  type               String   @default("vanilla") // vanilla | paper | spigot | forge | fabric
  version            String   @default("1.20.4")
  status             String   @default("offline")
  motd               String   @default("A Minecraft Server")
  host               String   @default("")
  port               Int      @default(25565)
  maxPlayers         Int      @default(20)
  players            Int      @default(0)
  cpu                Float    @default(0)
  ram                Float    @default(0)
  ramMax             Int      @default(768)
  uptime             Int      @default(0)
  worldName          String   @default("world")
  // World settings
  levelType          String   @default("minecraft\\default") // minecraft\default | minecraft\flat | minecraft\large_biomes | minecraft\amplified | minecraft\single_biome
  levelSeed          String   @default("")
  generateStructures Boolean  @default(true)
  // Difficulty / gamemode
  difficulty         String   @default("normal")
  gamemode           String   @default("survival")
  hardcore           Boolean  @default(false)
  pvp                Boolean  @default(true)
  whitelist          Boolean  @default(false)
  // Performance limits
  viewDistance       Int      @default(8)
  simulationDistance Int      @default(8)
  spawnProtection    Int      @default(16)
  maxWorldSize       Int      @default(29999984)
  maxTickTime        Int      @default(60000)
  // Behavior flags
  allowNether        Boolean  @default(true)
  allowFlight        Boolean  @default(false)
  enableCommandBlock Boolean  @default(false)
  enforceSecureProfile Boolean @default(false)
  onlineMode         Boolean  @default(false)
  // Network
  resourcePack       String   @default("")
  resourcePackSha1   String   @default("")
  requireResourcePack Boolean @default(false)
  // Tunneling
  playitAddress      String?  // assigned playit.gg address (e.g. word-word.playit.gg:12345)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerId])
}

model PlayerSession {
  id        String   @id @default(cuid())
  serverId  String
  username  String
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  @@index([serverId])
}
